# Public site origin used for canonical URLs, the sitemap, and Open Graph.
# Example: https://example.com
NEXT_PUBLIC_SITE_URL=

# Non-secret build identity: local, company-preview, or company-production.
VONTE_ENVIRONMENT=local

# Optional public contact details. Leave blank until they are real.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# Optional scheduling page. When set, "Book a Strategy Call" opens this URL.
# The consultation form remains available at /contact.
NEXT_PUBLIC_SCHEDULING_URL=

# Optional voice-demo phone number. When set, the product example links to it.
# The on-screen demo stays a scripted illustration.
NEXT_PUBLIC_VOICE_DEMO_NUMBER=

# Set to netlify-blobs on Netlify; leave blank for local file storage.
INQUIRY_STORAGE=

# Local file storage only. Default: ./data/inquiries
INQUIRY_DATA_DIR=

# Optional webhook. VONTE POSTs the saved inquiry as JSON.
INQUIRY_WEBHOOK_URL=
INQUIRY_WEBHOOK_SECRET=

# Optional email notification through Resend. Set all three, or none.
RESEND_API_KEY=
INQUIRY_FROM_EMAIL=
INQUIRY_NOTIFY_EMAIL=
